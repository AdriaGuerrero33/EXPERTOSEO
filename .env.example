# ============================================================
# EXPERTOSEO - Variables de Entorno
# Copia este archivo como .env y rellena tus credenciales
# ============================================================

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=tu_api_key_aqui

# --- OpenAI (DALL-E 3 para portadas) ---
OPENAI_API_KEY=tu_api_key_aqui

# --- Unsplash (fallback para imágenes) ---
UNSPLASH_ACCESS_KEY=tu_access_key_aqui

# --- Google Search Console ---
# Ruta al archivo JSON de la cuenta de servicio de Google
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json
# O bien la propiedad de GSC directamente
GSC_SITE_URL=https://tusitio.com

# --- SerpAPI (análisis de competencia, opcional) ---
SERPAPI_KEY=tu_api_key_aqui

# --- WordPress Application Passwords ---
# Para cada sitio, añade una variable con el nombre WP_APP_PASSWORD_<NOMBRE_SITE>
# El nombre del site debe coincidir con el slug en config.yaml (en mayúsculas)
WP_APP_PASSWORD_SITE1=usuario:xxxx xxxx xxxx xxxx xxxx xxxx
WP_APP_PASSWORD_SITE2=usuario:xxxx xxxx xxxx xxxx xxxx xxxx
